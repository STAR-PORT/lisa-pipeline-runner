apiVersion: argoproj.io/v1alpha1
kind: ClusterWorkflowTemplate
metadata:
  name: sync-module

spec:
  templates:

  - name: sync

    inputs:
      parameters:
      - name: input_uri
        default: ""

      - name: output_uri
        default: ""

      - name: user
        default: "admin"

    resource:
      action: create
      setOwnerReference: false
      successCondition: status.succeeded == 1
      failureCondition: status.failed == 1
      manifest: |
        apiVersion: batch/v1
        kind: Job
        metadata:
          generateName: argo-sync-
          namespace: default
          resourceVersion: "1"
        spec:
          ttlSecondsAfterFinished: 300
          template:
            metadata:
              annotations:
                slurm-job.vk.io/flags: >-
                  --account=${SLURM_ACCOUNT}
                  --partition=${SLURM_PARTITION}
            spec:
              nodeSelector:
                kubernetes.io/hostname: interlink-node
              tolerations:
              - key: virtual-node.interlink/no-schedule
                operator: Exists
              restartPolicy: Never
              automountServiceAccountToken: false
              containers:
              - name: main
                image: ubuntu:22.04
                command: ["bash", "-c"]
                args:
                - "echo 'sync module' && echo 'wrapper handles synchronization'"
                env:
                - name: INPUT_URI
                  value: "{{inputs.parameters.input_uri}}"
                - name: OUTPUT_URI
                  value: "{{inputs.parameters.output_uri}}"
                - name: ARGO_USER
                  value: "{{inputs.parameters.user}}"
                resources:
                  requests:
                    cpu: "1"
                    memory: "512Mi"
                  limits:
                    cpu: "1"
                    memory: "512Mi"