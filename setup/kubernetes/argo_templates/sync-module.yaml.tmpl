apiVersion: argoproj.io/v1alpha1
kind: ClusterWorkflowTemplate
metadata:
  name: sync-module

spec:
  templates:

  - name: sync

    inputs:
      parameters:
      - name: input_uri
        default: ""

      - name: output_uri
        default: ""

      - name: user
        default: "admin"

    resource:
      action: create
      setOwnerReference: false
      successCondition: status.succeeded == 1
      failureCondition: status.failed == 1
      manifest: |
        apiVersion: batch/v1
        kind: Job
        metadata:
          generateName: argo-sync-
          namespace: default
          resourceVersion: "1"
        spec:
          ttlSecondsAfterFinished: 300
          template:
            metadata:
              annotations:
                slurm-job.vk.io/flags: >-
                  --account=${SLURM_ACCOUNT}
                  --partition=${SLURM_PARTITION}
            spec:
              nodeSelector:
                kubernetes.io/hostname: interlink-node
              tolerations:
              - key: virtual-node.interlink/no-schedule
                operator: Exists
              restartPolicy: Never
              automountServiceAccountToken: false
              containers:
              - name: main
                image: ubuntu:22.04
                command: ["bash", "-c"]
                args:
                - |
                  set -euo pipefail

                  mc alias set cluster-store "$OBJECT_STORE_ENDPOINT" \
                    "$OBJECT_STORE_ACCESS_KEY" "$OBJECT_STORE_SECRET_KEY"
                  mc mb --ignore-existing "cluster-store/$OBJECT_STORE_BUCKET"

                  validate_path() {
                    local path="$1"
                    if [[ "$path" == *".."* ]]; then
                      echo "invalid data path: $path" >&2
                      exit 1
                    fi
                    case "$path" in
                      "/users/$ARGO_USER"|"/users/$ARGO_USER/"*|"/users/system"|"/users/system/"*) ;;
                      *)
                        echo "data path is outside the user's storage: $path" >&2
                        exit 1
                        ;;
                    esac
                  }

                  if [[ -n "$INPUT_URI" ]]; then
                    validate_path "$INPUT_URI"
                    mkdir -p "$INPUT_URI"
                    mc mirror --overwrite \
                      "cluster-store/$OBJECT_STORE_BUCKET/${INPUT_URI#/}" \
                      "$INPUT_URI"
                  fi

                  if [[ -n "$OUTPUT_URI" ]]; then
                    validate_path "$OUTPUT_URI"
                    mc mirror --overwrite \
                      "$OUTPUT_URI" \
                      "cluster-store/$OBJECT_STORE_BUCKET/${OUTPUT_URI#/}"
                  fi
                env:
                - name: INPUT_URI
                  value: "{{inputs.parameters.input_uri}}"
                - name: OUTPUT_URI
                  value: "{{inputs.parameters.output_uri}}"
                - name: ARGO_USER
                  value: "{{inputs.parameters.user}}"
                - name: OBJECT_STORE_ENDPOINT
                  value: "${OBJECT_STORE_ENDPOINT}"
                - name: OBJECT_STORE_BUCKET
                  value: "${OBJECT_STORE_BUCKET}"
                - name: OBJECT_STORE_ACCESS_KEY
                  valueFrom:
                    secretKeyRef:
                      name: lisa-object-store
                      key: access-key
                - name: OBJECT_STORE_SECRET_KEY
                  valueFrom:
                    secretKeyRef:
                      name: lisa-object-store
                      key: secret-key
                resources:
                  requests:
                    cpu: "1"
                    memory: "512Mi"
                  limits:
                    cpu: "1"
                    memory: "512Mi"