apiVersion: argoproj.io/v1alpha1
kind: WorkflowTemplate
metadata:
  name: compute-transform-module
  namespace: default

spec:
  templates:

  - name: compute-transform

    inputs:
      parameters:
      - name: input_file
        default: "/users/admin/input.txt"

      - name: output_file
        default: "/users/admin/output.txt"

      - name: cpu
        default: "2"

      - name: memory
        default: "2Gi"

      - name: user
        default: "admin"

    resource:
      action: create
      setOwnerReference: true
      successCondition: status.succeeded == 1
      failureCondition: status.failed == 1
      manifest: |
        apiVersion: batch/v1
        kind: Job
        metadata:
          generateName: argo-compute-transform-
          namespace: default
          resourceVersion: "1"
        spec:
          ttlSecondsAfterFinished: 300
          template:
            metadata:
              annotations:
                slurm-job.vk.io/flags: >-
                  --account=${SLURM_ACCOUNT}
                  --partition=${SLURM_PARTITION}
                  --cpus-per-task={{inputs.parameters.cpu}}
                  --mem={{inputs.parameters.memory}}
            spec:
              nodeSelector:
                kubernetes.io/hostname: interlink-node
              tolerations:
              - key: virtual-node.interlink/no-schedule
                operator: Exists
              restartPolicy: Never
              automountServiceAccountToken: false
              containers:
              - name: main
                image: ubuntu:22.04
                command: ["bash", "-c"]
                args:
                - |
                  set -e
                  echo "compute module: transform"

                  tr '[:lower:]' '[:upper:]' \
                    < "{{inputs.parameters.input_file}}" \
                    > "{{inputs.parameters.output_file}}"

                  sleep 30

                env:
                - name: ARGO_USER
                  value: "{{inputs.parameters.user}}"
                resources:
                  requests:
                    cpu: "1"
                    memory: "512Mi"
                  limits:
                    cpu: "1"
                    memory: "512Mi"