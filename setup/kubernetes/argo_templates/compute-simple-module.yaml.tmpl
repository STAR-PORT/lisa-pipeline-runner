apiVersion: argoproj.io/v1alpha1
kind: ClusterWorkflowTemplate
metadata:
  name: compute-simple-module

spec:
  templates:

  - name: compute-simple

    inputs:
      parameters:
      - name: cpu
        default: "2"

      - name: memory
        default: "2Gi"

      - name: user
        default: "admin"

    resource:
      action: create
      setOwnerReference: false
      successCondition: status.succeeded == 1
      failureCondition: status.failed == 1
      manifest: |
        apiVersion: batch/v1
        kind: Job
        metadata:
          generateName: argo-compute-simple-
          namespace: default
          resourceVersion: "1"
        spec:
          ttlSecondsAfterFinished: 300
          template:
            metadata:
              annotations:
                slurm-job.vk.io/flags: >-
                  --account=${SLURM_ACCOUNT}
                  --partition=${SLURM_PARTITION}
                  --cpus-per-task={{inputs.parameters.cpu}}
                  --mem={{inputs.parameters.memory}}
            spec:
              nodeSelector:
                kubernetes.io/hostname: interlink-node
              tolerations:
              - key: virtual-node.interlink/no-schedule
                operator: Exists
              restartPolicy: Never
              automountServiceAccountToken: false
              containers:
              - name: main
                image: ubuntu:22.04
                command: ["bash", "-c"]
                args:
                - |
                  set -e
                  echo "compute module: doing nothing"

                  sleep 10

                env:
                - name: ARGO_USER
                  value: "{{inputs.parameters.user}}"
                resources:
                  requests:
                    cpu: "1"
                    memory: "512Mi"
                  limits:
                    cpu: "1"
                    memory: "512Mi"