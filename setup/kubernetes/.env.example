# Copy this file to k8s.env and edit values before running setup.sh

# Kubernetes versions
K8S_VERSION=1.35
K8S_FULL_VERSION=1.35.3
K8S_PKG_VERSION=1.35.3-1.1

# Calico CNI version
CALICO_VERSION=v3.28.0

# Argo Workflows version
ARGO_VERSION=v3.7.12

# InterLink settings
INTERLINK_VERSION=0.6.1
INTERLINK_INSTALL_DIR=/opt/interlink
INTERLINK_DATA_ROOT=/tmp/interlink
INTERLINK_NODE_NAME=interlink-node

# SSH/Sidecar settings for the InterLink bridge
SIDECAR_SSH_USER=isabelmoutinho
SIDECAR_SSH_HOST=ln01.deucalion.macc.fccn.pt
SIDECAR_SSH_KEY_PATH=/root/.ssh/id_ed25519
SIDECAR_LOCAL_HOST=192.168.67.64
SIDECAR_LOCAL_PORT=5000
SIDECAR_REMOTE_PORT=4000
