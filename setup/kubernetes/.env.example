# Copy this file to .env and edit values before running main.sh

# Kubernetes versions
K8S_VERSION=1.35
K8S_FULL_VERSION=1.35.3
K8S_PKG_VERSION=1.35.3-1.1

# Calico CNI version
CALICO_VERSION=v3.28.0

# Argo Workflows version
ARGO_VERSION=v3.7.12

# Dex version
DEX_VERSION=v2.37.0

# Required Dex/Argo admin password. Set a unique strong value before setup.
ARGO_ADMIN_PASSWORD=admin123

# VM's stable private interface address. Set this to the address Deucalion can
# reach through the SSH reverse forwards.
K8S_NODE_IP=10.0.2.15
# Browser-facing address for the Argo UI and Dex. With VirtualBox NAT, use a
# host-reachable/forwarded address if opening the UI from the laptop.
MACHINE_HOST=${K8S_NODE_IP}

# InterLink settings
INTERLINK_VERSION=0.6.1
INTERLINK_INSTALL_DIR=/opt/interlink
INTERLINK_DATA_ROOT=/tmp/interlink
INTERLINK_NODE_NAME=interlink-node

# SSH and reverse-forward settings for the InterLink bridge
SIDECAR_SSH_USER=isabelmoutinho
SIDECAR_SSH_HOST=ln02.deucalion.macc.fccn.pt
SIDECAR_SSH_KEY_PATH=/root/.ssh/id_ed25519
SIDECAR_LOCAL_HOST=127.0.0.1
SIDECAR_LOCAL_PORT=5000
SIDECAR_REMOTE_PORT=4000
HPC_FORWARD_BIND_ADDRESS=10.1.0.2
OBJECT_STORE_FORWARD_PORT=19001
K8S_API_FORWARD_PORT=19002

# Garage S3-compatible object storage
GARAGE_IMAGE=dxflrs/garage:v2.5.0
GARAGE_DATA_DIR=/var/lib/lisa-garage
OBJECT_STORE_NODE_PORT=30900
OBJECT_STORE_BUCKET=lisa
OBJECT_STORE_ACCESS_KEY=GKreplace-with-your-access-key
OBJECT_STORE_SECRET_KEY=replace-with-a-long-random-secret

# Slurm job settings
SLURM_ACCOUNT=F202500007HPCVLABUPORTOX
SLURM_PARTITION=normal-x86